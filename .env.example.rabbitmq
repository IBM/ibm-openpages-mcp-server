# ============================================================================
# GRC MCP Server - RabbitMQ Schema Synchronization Configuration
# ============================================================================
# This file shows the required environment variables for RabbitMQ-based
# schema cache synchronization. Copy these to your .env file and update
# with your actual values.

# OpenPages Instance Identification (REQUIRED for RabbitMQ)
# These values are used to construct the routing key automatically
# Format: v1.account.{OPENPAGES_ACCOUNT_ID}.instance.{OPENPAGES_INSTANCE_ID}.#
OPENPAGES_ACCOUNT_ID=999
OPENPAGES_INSTANCE_ID=testInstance123

# Enable RabbitMQ-based schema synchronization
# Set to true to enable automatic schema updates when metadata changes in OpenPages
RABBITMQ_ENABLED=true

# RabbitMQ Connection Details
# Host and port of your RabbitMQ broker
RABBITMQ_HOST=your-rabbitmq-host.com
RABBITMQ_PORT=5671

# RabbitMQ Authentication
# Credentials for connecting to RabbitMQ
RABBITMQ_USER=your-username
RABBITMQ_PASSWORD=your-password

# RabbitMQ Exchange Configuration
# Exchange name where OpenPages publishes metadata events
# Default: op.public.metadata
RABBITMQ_METADATA_EXCHANGE=op.public.metadata

# NOTE: Routing key is automatically constructed from OPENPAGES_ACCOUNT_ID and OPENPAGES_INSTANCE_ID
# Format: v1.account.{OPENPAGES_ACCOUNT_ID}.instance.{OPENPAGES_INSTANCE_ID}.#
# No need to set RABBITMQ_ROUTING_KEY manually

# MCP Server Deployment Name
# Optional prefix for queue naming (default: mcp-server)
# Queue name format: {MCP_SERVER_DEPLOYMENT_NAME}-{hostname}-{pid}
MCP_SERVER_DEPLOYMENT_NAME=mcp-server

# SSL/TLS Configuration
# Use SSL for secure connection (recommended for production)
RABBITMQ_USE_SSL=true

# Virtual Host
# RabbitMQ virtual host (default is /)
RABBITMQ_VIRTUAL_HOST=/

# Schema Update Interval
# How often (in seconds) to process queued schema updates
# Lower values = faster updates, higher values = less overhead
# Default: 60 seconds
SCHEMA_UPDATE_INTERVAL=60

# Secrets Path for SaaS Deployments
# Path to directory containing base64-encoded secret files
# When RABBITMQ_HOST, RABBITMQ_PORT, RABBITMQ_USER, RABBITMQ_PASSWORD are not set as env vars,
# the system will automatically read from files in this directory
SECRETS_PATH=/secrets/store

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Example 1: Local Development (On-Premise)
# RABBITMQ_ENABLED=true
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# OPENPAGES_ACCOUNT_ID=999
# OPENPAGES_INSTANCE_ID=dev-instance
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_METADATA_EXCHANGE=op.public.metadata
# MCP_SERVER_DEPLOYMENT_NAME=mcp-dev
# RABBITMQ_USE_SSL=false
# SCHEMA_UPDATE_INTERVAL=30

# Example 2: Production with SSL (On-Premise)
# RABBITMQ_ENABLED=true
# RABBITMQ_HOST=rabbitmq.production.company.com
# RABBITMQ_PORT=5671
# OPENPAGES_ACCOUNT_ID=123
# OPENPAGES_INSTANCE_ID=prod-instance
# RABBITMQ_USER=mcp-server-prod
# RABBITMQ_PASSWORD=secure-password-here
# RABBITMQ_METADATA_EXCHANGE=op.public.metadata
# MCP_SERVER_DEPLOYMENT_NAME=mcp-prod
# RABBITMQ_USE_SSL=true
# SCHEMA_UPDATE_INTERVAL=60

# Example 3: Kubernetes/OpenShift Deployment
# RABBITMQ_ENABLED=true
# RABBITMQ_HOST=rabbitmq.openpages.svc.cluster.local
# RABBITMQ_PORT=5671
# OPENPAGES_ACCOUNT_ID=456
# OPENPAGES_INSTANCE_ID=k8s-instance
# RABBITMQ_USER=mcp-server
# RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD_FROM_SECRET}
# RABBITMQ_METADATA_EXCHANGE=op.public.metadata
# MCP_SERVER_DEPLOYMENT_NAME=mcp-k8s
# RABBITMQ_USE_SSL=true
# SCHEMA_UPDATE_INTERVAL=60

# Example 4: SaaS Deployment (with region)
# RABBITMQ_ENABLED=true
# RABBITMQ_HOST=rabbitmq.saas.openpages.com
# RABBITMQ_PORT=5671
# OPENPAGES_ACCOUNT_ID=789
# OPENPAGES_INSTANCE_ID=tenant-instance
# RABBITMQ_USER=tenant-mcp-server
# RABBITMQ_PASSWORD=secure-password-here
# RABBITMQ_METADATA_EXCHANGE=op.public.metadata
# MCP_SERVER_DEPLOYMENT_NAME=mcp-saas-tenant
# RABBITMQ_USE_SSL=true
# SCHEMA_UPDATE_INTERVAL=60

# ============================================================================
# IMPORTANT NOTES
# ============================================================================

# 1. Routing Key Construction:
#    - Routing key is automatically constructed from OPENPAGES_ACCOUNT_ID and OPENPAGES_INSTANCE_ID
#    - Format: v1.account.{OPENPAGES_ACCOUNT_ID}.instance.{OPENPAGES_INSTANCE_ID}.#
#    - The # wildcard at the end matches all event types
#    - You MUST set OPENPAGES_ACCOUNT_ID and OPENPAGES_INSTANCE_ID in your .env file

# 2. Queue Naming:
#    - Each MCP server pod/instance creates a unique queue
#    - Format: {MCP_SERVER_DEPLOYMENT_NAME}-{hostname}-{pid}
#    - Example: mcp-server-pod-abc123-12345
#    - Queues are automatically deleted when pod stops (auto_delete=True)

# 3. Event Types Processed:
#    - BUNDLETYPE: Field changes (add, modify, remove fields)
#    - CONTENTTYPE: Relationship changes (associations between object types)

# 4. Deduplication:
#    - Multiple events for same objectType = single cache refresh
#    - Efficient: Only one OpenPages API call per objectType per interval

# 5. Automatic Cleanup:
#    - Old queues deleted immediately when pod stops (auto_delete=True)
#    - Safety net: Queues expire after 30 minutes of inactivity (x-expires)
#    - No queue accumulation - automatic lifecycle management

# 6. Graceful Degradation:
#    - If RabbitMQ unavailable, server continues normally
#    - Schemas loaded on-demand from OpenPages API
#    - No impact on MCP server functionality

# 7. Monitoring Endpoints:
#    - GET /api/cache/health - Health status
#    - GET /api/cache/stats - Detailed statistics
#    - GET /api/cache/rabbitmq - RabbitMQ connection details

# 8. Security Best Practices:
#    - Always use SSL in production (RABBITMQ_USE_SSL=true)
#    - Store credentials in secrets management (not in .env file)
#    - Never commit credentials to version control
#    - Rotate credentials regularly
#    - Use port 5671 for AMQPS (SSL/TLS)

# 8a. SaaS File-Based Credentials:
#    - For SaaS deployments, credentials can be mounted as files in SECRETS_PATH
#    - Files should contain base64-encoded values
#    - File names: RABBITMQ_HOST, RABBITMQ_PORT, RABBITMQ_USER, RABBITMQ_PASSWORD
#    - System automatically falls back to file-based credentials when env vars are not set
#    - Example: echo -n "rabbitmq.example.com" | base64 > /secrets/store/RABBITMQ_HOST

# 9. Performance Tuning:
#    - Adjust SCHEMA_UPDATE_INTERVAL based on your needs:
#      * Lower (30s) = faster updates, more overhead
#      * Higher (120s) = slower updates, less overhead
#      * Default (60s) = good balance for most deployments

# 10. High Availability:
#     - Multiple MCP server pods can run simultaneously
#     - Each pod maintains its own queue and cache
#     - Events delivered to all pods
#     - No coordination required between pods

# ============================================================================
# For more information, see: docs/SCHEMA_CACHE_SYNCHRONIZATION.md
# ============================================================================