# GRC MCP Server Configuration
#
# This file contains all configuration options for the GRC MCP Server.
# Settings marked as [MANDATORY] must be configured for the server to start.
# Settings marked as [OPTIONAL] have sensible defaults and can be omitted.

# ============================================================================
# MANDATORY SETTINGS - These MUST be configured
# ============================================================================

# [MANDATORY] OpenPages Base URL
# Base URL for OpenPages API
# - Standard OpenPages: https://your-openpages-instance.com
# - CP4D: https://cpd-zen-ns.apps.example.com/openpages-instance-name (include the full path)
OPENPAGES_BASE_URL=https://your-openpages-instance.com

# [OPTIONAL] Authentication Type - This is only needed for dev/onprem environments. As user based authentication is not supported in dev/on-prem
# Options: "basic" or "bearer"
# - "basic": Use username/password for basic authentication
# - "bearer": Use API key for IBM Cloud IAM/MCSP, OR username/password for CP4D
OPENPAGES_AUTHENTICATION_TYPE=bearer

# [OPTIONAL] [MANDATORY for basic auth if deployment is dev/onprem] Basic Authentication Credentials
# Required when OPENPAGES_AUTHENTICATION_TYPE=basic
OPENPAGES_USERNAME=
OPENPAGES_PASSWORD=

# [OPTIONAL] [MANDATORY for bearer auth if deployment is dev/onprem] Bearer Authentication Settings
# Required when OPENPAGES_AUTHENTICATION_TYPE=bearer
OPENPAGES_AUTHENTICATION_URL=

# [MANDATORY for IBM Cloud/MCSP bearer auth] API Key
# Required for IBM Cloud IAM/MCSP authentication
# You can either set the API key directly or provide a path to a file containing it
OPENPAGES_APIKEY=
# Or use a file path (useful for Kubernetes secrets, Docker secrets, etc.)
# OPENPAGES_APIKEY_FILE=/run/secrets/openpages_apikey

# [MANDATORY for CP4D bearer auth] CP4D Credentials
# Required when using CP4D (detected by /icp4d-api/v1/authorize in auth URL)
# OPENPAGES_USERNAME=cpadmin
# OPENPAGES_PASSWORD=your_password

# Example CP4D Configuration:
# OPENPAGES_AUTHENTICATION_TYPE=bearer
# OPENPAGES_BASE_URL=https://cpd-zen-ns.apps.ajk-cognos.cp.fyre.ibm.com/openpages-openpagesinstance-with-25
# OPENPAGES_USERNAME=cpadmin
# OPENPAGES_PASSWORD=your_password
# OPENPAGES_AUTHENTICATION_URL=https://cpd-zen-ns.apps.ajk-cognos.cp.fyre.ibm.com/icp4d-api/v1/authorize
# SSL_VERIFY=false

# [MANDATORY for RabbitMQ] OpenPages Instance Identification
# These values are used to construct the RabbitMQ routing key
# Format: v1.account.{OPENPAGES_ACCOUNT_ID}.instance.{OPENPAGES_INSTANCE_ID}.#
# Example: v1.account.999.instance.testInstance123.#
OPENPAGES_ACCOUNT_ID=999
OPENPAGES_INSTANCE_ID=testInstance123

#This is to form external url to return in the response since all base urls are planned to be internal
OP_EXT_HOST=

# ============================================================================
# OPTIONAL SETTINGS - These have sensible defaults
# ============================================================================

# [OPTIONAL] Environment Mode
# Options: "development" or "production" (default: "production")
# - "development": Eagerly initializes authentication and loads schemas at startup (fail-fast)
# - "production": Lazy initialization - authentication happens on first request with Authorization header
#   This allows bearer tokens to be provided per-request without requiring credentials in .env
ENVIRONMENT=production
# ============================================================================

# Application Settings (Optional)
APP_NAME=grc-mcp-server
DEBUG=false
SERVER_MODE=remote

# Server Settings (Optional)
HOST=0.0.0.0
PORT=8000

# SSL Settings (Optional - defaults to true for security)
# Set to false for development/test environments with self-signed certificates
# WARNING: Setting to false disables SSL certificate verification (security risk in production)
# Common SSL errors that may require SSL_VERIFY=false:
#   - CERTIFICATE_VERIFY_FAILED
#   - Self-signed certificate
#   - Certificate hostname mismatch
SSL_VERIFY=true

# Logging Configuration (Optional)
# LOG_LEVEL: Logging verbosity level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# LOG_FORMAT: Log output format
# Options: json, text (default: json)
LOG_FORMAT=json

# LOG_FILE: Path to log file (optional, disabled by default)
# Example: logs/grc-mcp-server.log or /var/log/grc-mcp-server.log
# LOG_FILE=logs/grc-mcp-server.log

# LOG_MAX_BYTES: Max log file size before rotation in bytes (default: 10485760 = 10MB)
LOG_MAX_BYTES=10485760

# LOG_BACKUP_COUNT: Number of backup log files to keep (default: 5)
LOG_BACKUP_COUNT=5

# Observability Settings (Optional - defaults to false)
# Enable observability features (metrics, tracing)
OBSERVABILITY_ENABLED=false

# Metrics Configuration (Optional - defaults to false)
# Metrics are exposed on the main server port at /metrics endpoint
METRICS_ENABLED=false

# Distributed Tracing Configuration (Optional - defaults to false)
TRACING_ENABLED=false
# OTLP_ENDPOINT: OpenTelemetry collector endpoint (required if tracing enabled)
# OTLP_ENDPOINT=http://localhost:4318
# CONSOLE_TRACING: Export traces to console for debugging (default: false)
CONSOLE_TRACING=false

# Rate Limiting Configuration (Optional - defaults to false)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# OPENPAGES_AUTH_MODE is the single explicit axis that
# drives auth posture (independent of ENVIRONMENT, SERVER_MODE, and OP topology — the
# latter is inferred from the auth URL):
# - "server" : the MCP server runs on its own credentials — no connection
#     gate, no per-call user-auth dance. Use for on-prem / Cloud Pak agent / local / dev.
# - "user" (default): production-remote multi-tenant — enforces the 4-key user-auth framework
#     behind a header gate. SaaS (and ticket-issuing Cloud Pak) deployments set this.
OPENPAGES_AUTH_MODE=user

# Object Types Configuration (Optional)
# Path to object types configuration file (default: src/app/config/object_types.json)
OBJECT_TYPES_CONFIG_PATH=src/app/config/object_types.json

# Currency Configuration (Optional)
# DEFAULT_CURRENCY: ISO 4217 currency code (e.g., USD, EUR, GBP, INR)
# Used as default when currency is not specified for CURRENCY_TYPE fields (default: USD)
DEFAULT_CURRENCY=USD

# Token Optimization Settings (Optional - Phase 2)
# SCHEMA_CACHE_MAX_SIZE: Maximum number of type definition schemas to cache (LRU)
# Default: 20 schemas
# Increase for environments with many object types, decrease to reduce memory usage
SCHEMA_CACHE_MAX_SIZE=200

# SCHEMA_CACHE_TTL: Schema cache time-to-live in seconds
# Default: 3600 (1 hour)
# Schemas are static but this ensures fresh data periodically
# Set to 0 to disable TTL (cache indefinitely until evicted)
SCHEMA_CACHE_TTL=3600

# ENABLE_MINIMAL_SCHEMA_MODE: Enable minimal schema mode for resource schemas
# Default: true
# Minimal mode returns only field names and types (87% smaller)
# Use for initial exploration, then switch to compact/full as needed
ENABLE_MINIMAL_SCHEMA_MODE=true

# CACHE_QUERY_EXAMPLES: Cache query examples with schemas
# Default: true
# Query examples are deterministic and can be cached
# Reduces CPU usage for schema generation
CACHE_QUERY_EXAMPLES=true

# MCP Session Management (Optional - Streamable HTTP transport, spec 2025-03-26)
# MCP_SESSION_ENFORCEMENT: Require Mcp-Session-Id header on all non-initialize requests
# Default: false (set to true for production-safety; enforces session lifecycle per spec)
# Set to false to allow clients that do not support session headers (e.g., MCP Inspector)
MCP_SESSION_ENFORCEMENT=false

# MCP_SESSION_TTL: Session time-to-live in seconds (default: 3600 = 1 hour)
# Sessions inactive for longer than this will be automatically cleaned up
# Prevents memory leaks from abandoned sessions
MCP_SESSION_TTL=3600

# MCP_SESSION_MAX_COUNT: Maximum number of concurrent sessions (default: 1000)
# New session requests will be rejected with 503 when limit is reached
# Prevents unbounded memory growth in high-traffic scenarios
MCP_SESSION_MAX_COUNT=1000

# MCP_SESSION_CLEANUP_INTERVAL: How often to run cleanup task in seconds (default: 300 = 5 minutes)
# Background task periodically removes expired sessions and orphaned SSE queues
# Lower values = more frequent cleanup but higher CPU usage
MCP_SESSION_CLEANUP_INTERVAL=300

# ============================================================================
# RABBITMQ SCHEMA SYNCHRONIZATION (Optional - for SaaS deployments)
# ============================================================================

# RABBITMQ_ENABLED: Enable RabbitMQ-based schema synchronization
# Default: false
# When enabled, the MCP server automatically updates its schema cache when
# OpenPages metadata changes (field additions/modifications, relationship changes)
# This eliminates the need for server restarts after metadata changes
RABBITMQ_ENABLED=false

# RABBITMQ_HOST: RabbitMQ broker hostname
# Required when RABBITMQ_ENABLED=true
# Example: rabbitmq.production.company.com
RABBITMQ_HOST=

# RABBITMQ_PORT: RabbitMQ broker port
# Default: 5671 (AMQPS with SSL/TLS)
# Use 5672 for non-SSL connections (not recommended for production)
RABBITMQ_PORT=5671

# RABBITMQ_USER: RabbitMQ authentication username
# Required when RABBITMQ_ENABLED=true
RABBITMQ_USER=

# RABBITMQ_PASSWORD: RabbitMQ authentication password
# Required when RABBITMQ_ENABLED=true
# Best practice: Use secrets management instead of hardcoding
RABBITMQ_PASSWORD=

# RABBITMQ_METADATA_EXCHANGE: Exchange name where OpenPages publishes metadata events
# Default: op.public.metadata
# This is the standard exchange name for OpenPages metadata events
RABBITMQ_METADATA_EXCHANGE=op.public.metadata

# RABBITMQ_USE_SSL: Use SSL/TLS for secure connection
# Default: true (recommended for production)
# Set to false only for local development
RABBITMQ_USE_SSL=true

# RABBITMQ_VIRTUAL_HOST: RabbitMQ virtual host
# Default: / (root virtual host)
RABBITMQ_VIRTUAL_HOST=/

# MCP_SERVER_DEPLOYMENT_NAME: Deployment name for queue naming
# Default: mcp-server
# Queue name format: {MCP_SERVER_DEPLOYMENT_NAME}-{hostname}-{pid}
# Example: mcp-prod-pod-abc123-12345
MCP_SERVER_DEPLOYMENT_NAME=mcp-server

# SCHEMA_UPDATE_INTERVAL: How often to process queued schema updates (seconds)
# Default: 60 seconds
# Lower values = faster updates but more overhead
# Higher values = slower updates but less overhead
# Recommended: 30-120 seconds depending on your needs
SCHEMA_UPDATE_INTERVAL=60

# SECRETS_PATH: Path to directory containing secret files for SaaS deployments
# Default: /secrets/store
# When RABBITMQ_HOST, RABBITMQ_PORT, RABBITMQ_USER, RABBITMQ_PASSWORD are not set as env vars,
# the system will look for base64-encoded files in this directory:
# - SECRETS_PATH/RABBITMQ_HOST
# - SECRETS_PATH/RABBITMQ_PORT
# - SECRETS_PATH/RABBITMQ_USER
# - SECRETS_PATH/RABBITMQ_PASSWORD
SECRETS_PATH=/secrets/store

# For detailed RabbitMQ configuration examples and documentation, see:
# - .env.example.rabbitmq (comprehensive examples)
# - docs/SCHEMA_CACHE_SYNCHRONIZATION.md (full documentation)
# ──────────────────────────────────────────────────────────────────────────
# Authentication framework (4 user-auth types, fixed priority)
# Priority: 1) Authorization header  2) op_auth_header  3) op_auth_ticket  4) API key
# (ticket outranks API key: the API key secures the connection, op_auth_ticket
#  drives per-call tool execution).
# Connection gate: a request must carry a credential in a header (Authorization or
# any configured API-key header) — except for server-credential deployments
# (dev / local / on-prem), where the gate is skipped. No env toggle.
# ──────────────────────────────────────────────────────────────────────────

# Type 4 — custom API-key header name(s, same-IDP exchange). Comma-separated list
# (default X-Api-Key) so different agent deployments can carry the key under different
# headers (first present wins).
SUPPORTED_APIKEY_AUTH_HEADER_NAMES=X-Api-Key

# Type 3 — embedded-chat ticket redeem + IDP refresh-artifact exchange.
# Deployment-driven (no enable/disable toggle): a ticket is only present when OpenPages issued one
# (SaaS / Cloud Pak). Ticket sessions are held in a per-pod in-process cache; redeemTicket is multi-use.
# The internal redeemTicket call targets the OpenPages REST API, always derived as
# OPENPAGES_BASE_URL + "/opgrc/api/v2/token/redeemTicket" — no separate config needed.
# Shared confidential OAuth client for the refresh-artifact exchange (isv / iam modes only).
# Provide either the direct value or an explicit *_FILE path to a mounted secret. No default
# path is assumed and no value is hardcoded; if a mode that needs an exchange is used and these
# are unset, the exchange fails fast. Not required for access-token mode (IBM Cloud IAM SaaS).
OPENPAGES_OAUTH_CLIENT_ID=
OPENPAGES_OAUTH_CLIENT_SECRET=
OPENPAGES_OAUTH_CLIENT_ID_FILE=
OPENPAGES_OAUTH_CLIENT_SECRET_FILE=
# API client id / audience (receiver_client_ids for IAM, audience for ISV)
OPENPAGES_OAUTH_AUDIENCE=
# IDP token endpoint for the ticket refresh-artifact exchange. Optional: when unset,
# the exchange falls back to OPENPAGES_AUTHENTICATION_URL (the same IDP in the common
# IBM Cloud case). The grant flow (IBM Cloud IAM delegated-refresh vs RFC 8693
# refresh_token) is derived from the resolved URL's type. Set this explicitly only when
# the user IDP token endpoint differs from OPENPAGES_AUTHENTICATION_URL (e.g. CP4D/ISV).
OPENPAGES_USER_IDP_TOKEN_URL=
# Token cache / refresh tuning (per-pod in-process ticket session cache)
AUTH_TOKEN_EXP_SKEW_SECONDS=60
AUTH_TOKEN_CACHE_TTL=3600
AUTH_TOKEN_CACHE_MAX_SIZE=100
