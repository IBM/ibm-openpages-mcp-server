# GRC MCP Server Configuration

# Application Settings
APP_NAME=grc-mcp-server
DEBUG=false
SERVER_MODE=remote

# Server Settings
HOST=0.0.0.0
PORT=8000

# OpenPages Configuration
#OPENPAGES_BASE_URL=https://20260102-0602-5569-9013-f93bd5bd1e0e.us-east-1.aws.dev.governance.ibm.com
