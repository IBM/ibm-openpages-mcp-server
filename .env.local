OPENPAGES_PASSWORD=passw0rd

OPENPAGES_AUTHENTICATION_TYPE=basic
#OPENPAGES_USERNAME=your_username
#OPENPAGES_PASSWORD=your_password
#OPENPAGES_APIKEY=azI6M2E5NDAzZDMtZTFjMS00YTUyLTk5MjgtNjlmMzc4OTFhYjgwOnhBUFEweFV3eEdTNHJzMGpDdStaYUkyb2IrbVBJRkZEOU9XMU1MdHNXcUE9
