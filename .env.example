# GRC MCP Server Configuration
#
# Quick Start:
#   - For minimal setup (on-premises or IBM Cloud HOSTED): Use .env.example.minimal.basic
#   - For minimal setup (IBM Cloud SaaS, MCSP, or CP4D): Use .env.example.minimal.bearer
#   - For detailed comments: See .env.example.full
#   - For comprehensive docs: See docs/CONFIGURATION_DEFAULTS.md

# ============================================================================
# MANDATORY SETTINGS
# ============================================================================

# OpenPages Connection
OPENPAGES_BASE_URL=https://your-openpages-instance.com
OPENPAGES_AUTHENTICATION_TYPE=bearer

# Basic Auth (required if OPENPAGES_AUTHENTICATION_TYPE=basic)
OPENPAGES_USERNAME=
OPENPAGES_PASSWORD=

# Bearer Auth (required if OPENPAGES_AUTHENTICATION_TYPE=bearer)
OPENPAGES_AUTHENTICATION_URL=
OPENPAGES_APIKEY=

# CP4D (required for CP4D deployments)
OPENPAGES_INSTANCE_NAME=

# OpenPages Instance Identification (required for RabbitMQ)
# These are used to construct the RabbitMQ routing key
OPENPAGES_ACCOUNT_ID=999
OPENPAGES_INSTANCE_ID=testInstance123

#This is to form external url to return in the response since all base urls are planned to be internal
OP_EXT_HOST=
# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Server
APP_NAME=grc-mcp-server
DEBUG=false
# Environment
ENVIRONMENT=production
SERVER_MODE=remote

# Server
HOST=0.0.0.0
PORT=8000

# SSL
SSL_VERIFY=true

# HTTP
HTTP_MAX_CONNECTIONS=20
# Auth posture: "user" (default, production/SaaS — per-user auth framework enforced) or
# "server" (on-prem / local / dev — server runs on its own credentials, no user-auth).
# Replaces the former AUTH_ENABLED flag: AUTH_ENABLED=false → OPENPAGES_AUTH_MODE=server
OPENPAGES_AUTH_MODE=user

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/grc-mcp.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Observability
OBSERVABILITY_ENABLED=false
METRICS_ENABLED=false
TRACING_ENABLED=false
OTLP_ENDPOINT=
CONSOLE_TRACING=false

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# Object Types
OBJECT_TYPES_CONFIG_PATH=src/app/config/object_types.json

# Currency
DEFAULT_CURRENCY=USD

# Schema Caching
# SCHEMA_CACHE_MAX_SIZE: Maximum number of type schemas to cache (LRU)
# Increased from 20 to 200 to support environments with 100+ object types without cache eviction
# Set to at least the number of configured object types to avoid eviction during background loading
SCHEMA_CACHE_MAX_SIZE=200
SCHEMA_CACHE_TTL=3600
ENABLE_MINIMAL_SCHEMA_MODE=true
CACHE_QUERY_EXAMPLES=true

# MCP Sessions
MCP_SESSION_ENFORCEMENT=false
MCP_SESSION_TTL=3600
MCP_SESSION_MAX_COUNT=1000
MCP_SESSION_CLEANUP_INTERVAL=300

# RabbitMQ Schema Synchronization (Optional - for SaaS deployments)
# Enable automatic schema updates when OpenPages metadata changes
RABBITMQ_ENABLED=false
RABBITMQ_HOST=
RABBITMQ_PORT=5671
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_METADATA_EXCHANGE=op.public.metadata
RABBITMQ_USE_SSL=true
RABBITMQ_VIRTUAL_HOST=/
MCP_SERVER_DEPLOYMENT_NAME=mcp-server
SCHEMA_UPDATE_INTERVAL=60

# Secrets Path for SaaS deployments (file-based credentials)
# When RABBITMQ_HOST, RABBITMQ_PORT, RABBITMQ_USER, RABBITMQ_PASSWORD are not set as env vars,
# the system will look for base64-encoded files in this directory
SECRETS_PATH=/secrets/store
