# Minimal configuration for Bearer Token Authentication
# Copy this to .env and fill in your values
#
# IMPORTANT: Bearer authentication is for IBM Cloud SaaS, MCSP, and CP4D deployments.
# For IBM Cloud HOSTED or ON-PREMISES instances, use .env.example.minimal.basic instead.

# OpenPages Instance (REQUIRED)
OPENPAGES_BASE_URL=https://your-openpages-instance.com

# Bearer Token Authentication (REQUIRED)
OPENPAGES_AUTHENTICATION_TYPE=bearer

# For IBM Cloud SaaS (NOT for IBM Cloud hosted instances)
OPENPAGES_AUTHENTICATION_URL=https://iam.cloud.ibm.com/identity/token
OPENPAGES_APIKEY=your_api_key
# Or use a file path to read the API key from (useful for Kubernetes secrets, Docker secrets, etc.)
# OPENPAGES_APIKEY_FILE=/run/secrets/openpages_apikey

# For MCSP (use these instead of IBM Cloud SaaS settings above)
# OPENPAGES_AUTHENTICATION_URL=https://account-iam.platform.saas.ibm.com/api/2.0/services/your-service-id/apikeys/token
# OPENPAGES_APIKEY=your_api_key

# For CP4D (use these instead of IBM Cloud SaaS settings above)
# OPENPAGES_AUTHENTICATION_URL=https://your-cp4d-instance.com/icp4d-api/v1/authorize
# OPENPAGES_USERNAME=your_username
# OPENPAGES_PASSWORD=your_password
# OPENPAGES_INSTANCE_NAME=your_instance_name

# SSL Verification (set to false for self-signed certificates in dev/test)
SSL_VERIFY=true

# ── Encryption at rest for secrets (on-prem) ────────────────────────────────
# Any value below may be stored encrypted instead of in plaintext, using the
# {enc}<base64> form -- the same convention as Liberty's {aes} in bootstrap.properties.
#
#   venv/bin/python3 manage_secrets.py init                    # once, at install
#   venv/bin/python3 manage_secrets.py encrypt --setting OPENPAGES_PASSWORD
#   venv/bin/python3 manage_secrets.py status                  # what is encrypted
#   venv/bin/python3 manage_secrets.py rotate                  # new key, re-encrypt all
#
#
# Plaintext still works and is unchanged -- encryption is opt-in per value.
#
# The keystore holds the key that decrypts them. Back it up: without it every {enc}
# value is unrecoverable. Never commit it (.gitignore excludes secrets/ and *.p12).
OP_MCP_KEYSTORE_PATH=secrets/op-mcp-keystore.p12
# Password protecting the keystore. Prefer the _FILE form: a file can be chmod 0600 to
# the service account, whereas an environment variable is visible to anything that can
# inspect the process or the container definition. This is the one secret that cannot
# itself be encrypted.
OP_MCP_KEYSTORE_PASSWORD_FILE=
# OP_MCP_KEYSTORE_PASSWORD=
